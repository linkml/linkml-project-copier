# ============== SSSOM mapping recipes ==============
# Imported by the main justfile because this project was created with
# `use_sssom`. The curated mappings live in src/<schema>/mappings as SSSOM
# files, and scripts/overlay_sssom.py replays them onto the schema.
# Specification: https://github.com/linkml/linkml-project-copier/issues/163

mappings_dir := src / schema_name / "mappings"

# Validate every curated SSSOM file with sssom-py
[group('model development')]
validate-sssom:
  for f in {{mappings_dir}}/*.sssom.tsv; do [ -e "$f" ] || continue; uv run sssom validate "$f" || exit 1; done

# Replay the curated SSSOM files onto the schema's mapping slots (pass --check to only report drift)
[group('model development')]
overlay-sssom *FLAGS:
  uv run python scripts/overlay_sssom.py {{FLAGS}} {{source_schema_path}} {{mappings_dir}}

# Export the schema's mapping slots as an SSSOM file under project/sssom
[group('model development')]
gen-sssom:
  mkdir -p {{dest}}/sssom
  uv run gen-sssom -o {{dest}}/sssom/{{schema_name}}.sssom.tsv {{source_schema_path}}
